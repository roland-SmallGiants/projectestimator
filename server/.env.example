# ".env" is git-ignored and is never read by Claude — only you manage it.

PRODUCTIVE_API_TOKEN=
PRODUCTIVE_ORGANIZATION_ID=
# Required — this is what the task-creation call actually uses to place the task.
PRODUCTIVE_TASK_LIST_ID=
# Optional — not used by the current task-creation call, kept for future use.
PRODUCTIVE_PROJECT_ID=
